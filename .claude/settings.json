      "Bash(powershell*build.ps1 -FetchPhoto*)",
      "Bash(powershell*build.ps1 -MakePortraits*)",
      "Bash(powershell*build.ps1 -ApplyPortraitReview*)",
      "Bash(powershell*build.ps1 -ReviewPage*)",
      "Bash(powershell*build.ps1 -ConvertPortraits*)",
      "Bash(powershell*build.ps1 -PreviewPortraits*)",
      "Bash(powershell*build.ps1 -RefreshGameData*)",
      "Bash(powershell*build.ps1 -SyncMirrors*)",
      "Bash(powershell*build.ps1 -RenderShowcase*)",
      "Bash(powershell*build.ps1 -Package*)",
      "Bash(powershell*Run-Tests.ps1*)",
      "Bash(*Test-HoiKnowledge.ps1*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
